# Copy to .env.local and fill in. All are optional while developing.

# Every booking is also POSTed here as JSON (Google Sheet Apps Script, CRM, Slack, Zapier...).
BOOKING_WEBHOOK_URL=

# Same, for technician applications from /partners.
PARTNER_WEBHOOK_URL=

# Password for /admin. Required in production: without it the admin does not
# exist there. While developing, leaving it empty keeps the admin open.
ADMIN_PASSWORD=
